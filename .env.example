# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Backend API server port
NOFX_BACKEND_PORT=8080

# Frontend web interface port
NOFX_FRONTEND_PORT=3000

# Timezone
NOFX_TIMEZONE=Asia/Shanghai

# ===========================================
# Authentication (Required)
# ===========================================

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# 管理后台邮箱白名单（逗号分隔，不区分大小写）。不设则默认内置运营邮箱。
# COMKUN_ADMIN_EMAILS=admin@example.com

# 财务台：可为其他用户做「正数站内入账」（与管理员正数调账同逻辑：流水 finance_adjust*、返利同步）。
# 逗号分隔；不设则默认包含 1013018910@qq.com。设为空列表请改为占位并改代码，或部署后写具体邮箱。
# COMKUN_FINANCE_EMAILS=1013018910@qq.com

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Optional: External Services
# ===========================================

DB_TYPE=postgres
DB_HOST=10.
DB_PORT=5432
DB_USER=nofx_user
DB_PASSWORD=
DB_NAME=nofx
DB_SSLMODE=disable


# Database configuration - SQLite (default)
DB_TYPE=sqlite
DB_PATH=data/data.db

# ===========================================
# 可选：给客户发「邮箱验证码」——在后端 .env 配置 SMTP 后重启 nofx 容器
# 不配发信时：验证码仍会生成，并打印在 docker logs nofx-trading 里，仅适合调试
# NOFX_SMTP_FROM：客户看到的「发件人」；NOFX_SMTP_USER/PASSWORD：多数邮箱用授权码
# ===========================================
# 以下两套任选其一（程序优先读 NOFX_ 前缀，没有则读简写名）
# NOFX_SMTP_HOST=smtp.example.com
# NOFX_SMTP_PORT=587
# NOFX_SMTP_USER=your-account@example.com
# NOFX_SMTP_PASSWORD=your-smtp-password-or-app-code
# NOFX_SMTP_FROM=nofx@example.com
# NOFX_SMTP_FROM_NAME=COMKUN-AI
# NOFX_SMTP_BRAND=COMKUN-AI
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-account@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-account@example.com
# 收件人看到的「发件人名称」（可选，默认与 SMTP_BRAND 一致，默认品牌 COMKUN-AI）
# SMTP_FROM_NAME=COMKUN-AI
# 邮件主题与 HTML 页眉里的品牌名（可选，默认 COMKUN-AI）
# SMTP_BRAND=COMKUN-AI
#
# ---------- Gmail（谷歌邮箱）示例 ----------
# 1) 打开 https://myaccount.google.com/security 开启「两步验证」
# 2) 再打开 https://myaccount.google.com/apppasswords 生成「邮件」类应用专用密码（16 位，不是登录密码）
# 3) 把下面改成你的邮箱后写入 .env，重启后端容器 nofx-trading
# NOFX_SMTP_HOST=smtp.gmail.com
# NOFX_SMTP_PORT=587
# NOFX_SMTP_USER=你的@gmail.com
# NOFX_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# NOFX_SMTP_FROM=你的@gmail.com
# （应用专用密码里的空格可保留或去掉均可）

# ===========================================
# Comkun 合规跟单（策略 config 中 comkun_market_follow=true 时使用）
# ===========================================
# 若策略 JSON 未填 comkun_market_source_strategy_id，则回退使用该 UUID 作为主广播的 source
# COMKUN_FOLLOW_DEFAULT_SOURCE_STRATEGY_ID=
# 策略市场上「官方跟单开关」那条上架 strategies.id（可选；与 config 中 comkun_follow_listing_template 二选一用于自动跟单子策略）
# COMKUN_FOLLOW_LISTING_STRATEGY_ID=

# ===========================================
# 可选：币安 API 经纪商返佣（newClientOrderId 前缀）
# ===========================================
# 合约：下单 ID 形如 x-{8位标识}…；不设则用内置默认（COMKUN 合约侧）。
# BINANCE_FUTURES_BROKER_ORDER_TAG=6UajqqpR
# 现货：本仓库当前无币安现货下单；若自行扩展现货下单，请用 8 位现货经纪商标识作同格式前缀：
# BINANCE_SPOT_BROKER_ORDER_TAG=EJ2MQNCB
# 管理后台返佣统计：需要币安 Broker API Key/Secret（开启对应 Broker 查询权限）。
# BINANCE_BROKER_API_KEY=
# BINANCE_BROKER_API_SECRET=

# ===========================================
# 策略市场详情 · 演示叠加（可选）
# ===========================================
# =1 时对策略名称匹配 NOFX_MARKET_DETAIL_DEMO_NAME_SUBSTR（默认「究极SOL,超级小亮,静默猎手」逗号分隔）注入虚拟指标；
# =0 或未设置则使用数据库真实汇总。恢复真实数据：设为 0 并重启 nofx 容器。
# NOFX_MARKET_DETAIL_DEMO=0
# NOFX_MARKET_DETAIL_DEMO_NAME_SUBSTR=究极SOL,超级小亮,静默猎手,静默测试,测试策略勿跟,测试02

# ===========================================
# 交易员数据看板 · 演示叠加（可选）
# ===========================================
# =1 时对 NOFX_TRADER_DEMO_IDS 列出的 trader_id（逗号分隔）返回虚拟账户/净值曲线/平仓明细/统计/决策日志；不落库。
# 留空 NOFX_TRADER_DEMO_IDS 时使用内置默认 ID（静默测试示例交易员）。
# NOFX_TRADER_DASHBOARD_DEMO=0
# NOFX_TRADER_DEMO_IDS=