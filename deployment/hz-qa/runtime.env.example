# Docker Compose isolation
HZ_QA_ENV_FILE=/root/.config/comkun-hz-qa/runtime.env
HZ_QA_DATA_DIR=/root/.local/share/comkun-hz-qa/data
HZ_QA_IMAGE_TAG=hz-qa
HZ_QA_LISTEN_ADDRESS=0.0.0.0
HZ_QA_FRONTEND_PORT=13000

# QA application
DB_TYPE=sqlite
DB_PATH=/app/data/data.db
JWT_SECRET=replace-with-random-value
DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key
RSA_PRIVATE_KEY=replace-with-single-line-pem
TRANSPORT_ENCRYPTION=false
EXPERIENCE_IMPROVEMENT=false
COMKUN_ADMIN_EMAILS=replace-with-qa-admin-email

# B -> A reliable event ingress
COMKUN_AI_EVENT_SECRET=replace-with-64-hex-shared-secret

# A -> B reconciliation; leave blank until the B master credential arrives
HZ_MASTER_POLL_API_URL=
HZ_MASTER_POLL_API_KEY=
HZ_MASTER_POLL_API_SECRET=
HZ_MASTER_POLL_ACCOUNT_ID=
HZ_MASTER_POLL_INTERVAL_SECONDS=30

# Disable unrelated external integrations in QA
AGENT_REBATE_BASE_URL=
AGENT_REBATE_PLATFORM_SECRET=
TELEGRAM_BOT_TOKEN=
